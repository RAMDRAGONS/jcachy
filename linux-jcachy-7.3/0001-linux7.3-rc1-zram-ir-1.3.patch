From 1e3714cb9ea3d5c9e9fba21b1784b238272d4ec5 Mon Sep 17 00:00:00 2001
From: Masahito S <firelzrd@gmail.com>
Date: Tue, 8 Sep 2026 01:07:30 +0900
Subject: [PATCH] linux7.3-rc1-zram-ir-1.3

Rebased onto the split zcomp R/W streams.

Immediate recompression compresses with secondary algorithms from the
write path, concurrently on every CPU, so secondary algorithms keep
per-CPU compression streams. recompress_store() keeps the dedicated
per-device stream, so it never contends with writers for a per-CPU
stream.

The compression stream is released right after zs_obj_write(), before
the slot lock is taken, as in the primary-only write path.
---
 drivers/block/zram/zcomp.c    | 35 +++++++++-----
 drivers/block/zram/zcomp.h    |  3 +-
 drivers/block/zram/zram_drv.c | 90 +++++++++++++++++++++++++++--------
 3 files changed, 95 insertions(+), 33 deletions(-)

diff --git a/drivers/block/zram/zcomp.c b/drivers/block/zram/zcomp.c
index 9bc3a357c9..5bcc2d4a11 100644
--- a/drivers/block/zram/zcomp.c
+++ b/drivers/block/zram/zcomp.c
@@ -151,13 +151,22 @@ ssize_t zcomp_available_show(const char *comp, char *buf, ssize_t at)
 	return at;
 }
 
+/*
+ * Secondary algorithms also compress on the write path (immediate
+ * recompression), so recompress_store() gets its own stream instead of
+ * contending with writers for the per-CPU ones.
+ */
+struct zcomp_cstrm *zcomp_recomp_cstrm_get(struct zcomp *comp)
+{
+	if (!comp->recomp_cstream)
+		return zcomp_cstrm_get(comp);
+
+	mutex_lock(&comp->recomp_cstream->lock);
+	return comp->recomp_cstream;
+}
+
 struct zcomp_cstrm *zcomp_cstrm_get(struct zcomp *comp)
 {
-	if (comp->recomp_cstream) {
-		mutex_lock(&comp->recomp_cstream->lock);
-		return comp->recomp_cstream;
-	}
-
 	for (;;) {
 		struct zcomp_cstrm *zstrm = raw_cpu_ptr(comp->cstream);
 
@@ -305,16 +314,16 @@ static int zcomp_init(struct zcomp *comp, struct zcomp_params *params,
 			comp->recomp_cstream = NULL;
 			goto cleanup;
 		}
-	} else {
-		comp->cstream = alloc_percpu(struct zcomp_cstrm);
-		if (!comp->cstream) {
-			ret = -ENOMEM;
-			goto cleanup;
-		}
-		for_each_possible_cpu(cpu)
-			mutex_init(&per_cpu_ptr(comp->cstream, cpu)->lock);
 	}
 
+	comp->cstream = alloc_percpu(struct zcomp_cstrm);
+	if (!comp->cstream) {
+		ret = -ENOMEM;
+		goto cleanup;
+	}
+	for_each_possible_cpu(cpu)
+		mutex_init(&per_cpu_ptr(comp->cstream, cpu)->lock);
+
 	comp->dstream = alloc_percpu(struct zcomp_dstrm);
 	if (!comp->dstream) {
 		ret = -ENOMEM;
diff --git a/drivers/block/zram/zcomp.h b/drivers/block/zram/zcomp.h
index a1c390b0b1..f0a72923a0 100644
--- a/drivers/block/zram/zcomp.h
+++ b/drivers/block/zram/zcomp.h
@@ -31,7 +31,7 @@ struct zcomp_params {
 /*
  * Run-time driver context - scratch buffers, etc. It is modified during
  * request execution (compression/decompression), cannot be shared, so
- * it's in per-CPU area (except for recompression, which uses a single
+ * it's in per-CPU area (recompression additionally has a single
  * per-device compression stream).
  */
 struct zcomp_ctx {
@@ -98,6 +98,7 @@ struct zcomp *zcomp_create(const char *alg, struct zcomp_params *params,
 void zcomp_destroy(struct zcomp *comp);
 
 struct zcomp_cstrm *zcomp_cstrm_get(struct zcomp *comp);
+struct zcomp_cstrm *zcomp_recomp_cstrm_get(struct zcomp *comp);
 void zcomp_cstrm_put(struct zcomp_cstrm *zstrm);
 
 struct zcomp_dstrm *zcomp_dstrm_get(struct zcomp *comp);
diff --git a/drivers/block/zram/zram_drv.c b/drivers/block/zram/zram_drv.c
index 45c22fd94f..1ff1407fd8 100644
--- a/drivers/block/zram/zram_drv.c
+++ b/drivers/block/zram/zram_drv.c
@@ -56,6 +56,23 @@ static size_t huge_class_size;
 
 static const struct block_device_operations zram_devops;
 
+#ifdef CONFIG_ZRAM_MULTI_COMP
+u8 __read_mostly sysctl_zram_recomp_immediate = 1;
+
+static const struct ctl_table zram_sysctl_table[] = {
+	{
+		.procname	= "zram_recomp_immediate",
+		.data		= &sysctl_zram_recomp_immediate,
+		.maxlen		= sizeof(u8),
+		.mode		= 0644,
+		.proc_handler	= proc_dou8vec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= SYSCTL_THREE,
+	},
+};
+static struct ctl_table_header *zram_sysctl_table_header;
+#endif //CONFIG_ZRAM_MULTI_COMP
+
 static void slot_free(struct zram *zram, unsigned long index);
 
 /*
@@ -2243,7 +2260,7 @@ static int write_same_filled_page(struct zram *zram, unsigned long fill,
 }
 
 static int write_incompressible_page(struct zram *zram, struct page *page,
-				     unsigned long index)
+				     unsigned long index, u8 prio, bool incompressible)
 {
 	unsigned long handle;
 	void *src;
@@ -2271,8 +2288,11 @@ static int write_incompressible_page(struct zram *zram, struct page *page,
 	slot_lock(zram, index);
 	slot_free(zram, index);
 	set_slot_flag(zram, index, ZRAM_HUGE);
+	if (incompressible)
+		set_slot_flag(zram, index, ZRAM_INCOMPRESSIBLE);
 	set_slot_handle(zram, index, handle);
 	set_slot_size(zram, index, PAGE_SIZE);
+	set_slot_comp_priority(zram, index, prio);
 	slot_unlock(zram, index);
 
 	atomic64_add(PAGE_SIZE, &zram->stats.compr_data_size);
@@ -2290,9 +2310,13 @@ static int zram_write_page(struct zram *zram, struct page *page,
 	unsigned long handle;
 	unsigned int comp_len;
 	void *mem;
-	struct zcomp_cstrm *zstrm;
+	struct zcomp_cstrm *zstrm = NULL;
 	unsigned long element;
 	bool same_filled;
+	u8 prio, prio_max = ZRAM_MAX_COMPS, last_prio = ZRAM_PRIMARY_COMP;
+#ifdef CONFIG_ZRAM_MULTI_COMP
+	prio_max = min_t(u8, prio_max, sysctl_zram_recomp_immediate + 1);
+#endif //CONFIG_ZRAM_MULTI_COMP
 
 	mem = kmap_local_page(page);
 	same_filled = page_same_filled(mem, &element);
@@ -2300,35 +2324,45 @@ static int zram_write_page(struct zram *zram, struct page *page,
 	if (same_filled)
 		return write_same_filled_page(zram, element, index);
 
-	zstrm = zcomp_cstrm_get(zram->comps[ZRAM_PRIMARY_COMP]);
-	mem = kmap_local_page(page);
-	ret = zcomp_compress(zram->comps[ZRAM_PRIMARY_COMP], zstrm,
-			     mem, &comp_len);
-	kunmap_local(mem);
+	for (prio = ZRAM_PRIMARY_COMP; prio < prio_max; prio++) {
+		if (!zram->comps[prio])
+			continue;
+		last_prio = prio;
+
+		zstrm = zcomp_cstrm_get(zram->comps[prio]);
+		mem = kmap_local_page(page);
+		ret = zcomp_compress(zram->comps[prio], zstrm,
+				     mem, &comp_len);
+		kunmap_local(mem);
+
+		if (unlikely(ret)) {
+			pr_err("Compression failed! err=%d\n", ret);
+			goto out;
+		}
+
+		if (comp_len < huge_class_size)
+			break;
 
-	if (unlikely(ret)) {
 		zcomp_cstrm_put(zstrm);
-		pr_err("Compression failed! err=%d\n", ret);
-		return ret;
+		zstrm = NULL;
 	}
 
-	if (comp_len >= huge_class_size) {
-		zcomp_cstrm_put(zstrm);
-		return write_incompressible_page(zram, page, index);
-	}
+	if (!zstrm)
+		return write_incompressible_page(zram, page, index, last_prio,
+						 prio >= ZRAM_MAX_COMPS);
 
 	handle = zs_malloc(zram->mem_pool, comp_len,
 			   GFP_NOIO | __GFP_NOWARN |
 			   __GFP_HIGHMEM | __GFP_MOVABLE, page_to_nid(page));
 	if (IS_ERR_VALUE(handle)) {
-		zcomp_cstrm_put(zstrm);
-		return PTR_ERR((void *)handle);
+		ret = PTR_ERR((void *)handle);
+		goto out;
 	}
 
 	if (!zram_can_store_page(zram)) {
-		zcomp_cstrm_put(zstrm);
 		zs_free(zram->mem_pool, handle);
-		return -ENOMEM;
+		ret = -ENOMEM;
+		goto out;
 	}
 
 	zs_obj_write(zram->mem_pool, handle, zstrm->buffer, comp_len);
@@ -2338,12 +2372,17 @@ static int zram_write_page(struct zram *zram, struct page *page,
 	slot_free(zram, index);
 	set_slot_handle(zram, index, handle);
 	set_slot_size(zram, index, comp_len);
+	set_slot_comp_priority(zram, index, prio);
 	slot_unlock(zram, index);
 
 	/* Update stats */
 	atomic64_inc(&zram->stats.pages_stored);
 	atomic64_add(comp_len, &zram->stats.compr_data_size);
 
+	return 0;
+
+out:
+	zcomp_cstrm_put(zstrm);
 	return ret;
 }
 
@@ -2473,7 +2512,7 @@ static int recompress_slot(struct zram *zram, unsigned long index,
 	 */
 	clear_slot_flag(zram, index, ZRAM_IDLE);
 
-	zstrm = zcomp_cstrm_get(zram->comps[prio]);
+	zstrm = zcomp_recomp_cstrm_get(zram->comps[prio]);
 	src = kmap_local_page(page);
 	ret = zcomp_compress(zram->comps[prio], zstrm, src, &comp_len_new);
 	kunmap_local(src);
@@ -3309,6 +3348,15 @@ static int __init zram_init(void)
 		num_devices--;
 	}
 
+#ifdef CONFIG_ZRAM_MULTI_COMP
+#define ZRAM_IR_VERSION "1.3"
+#define ZRAM_IR_PROGNAME "ZRAM Immediate Recompression (ZRAM-IR)"
+#define ZRAM_IR_AUTHOR   "Masahito Suzuki"
+	printk(KERN_INFO "%s %s by %s\n",
+		ZRAM_IR_PROGNAME, ZRAM_IR_VERSION, ZRAM_IR_AUTHOR);
+	zram_sysctl_table_header = register_sysctl("vm", zram_sysctl_table);
+#endif //CONFIG_ZRAM_MULTI_COMP
+
 	return 0;
 
 out_error:
@@ -3318,6 +3366,10 @@ static int __init zram_init(void)
 
 static void __exit zram_exit(void)
 {
+#ifdef CONFIG_ZRAM_MULTI_COMP
+	unregister_sysctl_table(zram_sysctl_table_header);
+#endif //CONFIG_ZRAM_MULTI_COMP
+
 	destroy_devices();
 }
 
-- 
2.56.0

